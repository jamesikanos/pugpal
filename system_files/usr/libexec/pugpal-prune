#!/usr/bin/bash
# Weekly housekeeping: reclaim disk that Docker, rootless Podman and Flatpak
# never give back on their own. Removes only things unused for 7+ days. NEVER
# touches Docker/Podman volumes - those are data; deleting them stays a manual
# decision.
#   systemd: pugpal-prune.timer (weekly)   manual: ujust pugpal-clean
set -uo pipefail
age=${PUGPAL_PRUNE_AGE:-168h}

if command -v docker >/dev/null && docker info >/dev/null 2>&1; then
    echo "== docker before"; docker system df
    # Stopped containers, unused networks, unused images (not just dangling)
    # older than $age. No --volumes.
    docker system prune --all --force --filter "until=${age}"
    docker builder prune --all --force --filter "until=${age}"
    echo "== docker after"; docker system df
else
    echo "docker not running - skipped"
fi

# Rootless Podman storage is per user (~/.local/share/containers): local
# image builds (`just build`) pile up superseded layers there. GitHub + ghcr.io
# are the source of truth, so anything older than $age is rebuildable. Note
# podman's `until` means *created* before $age (Docker's means unused), so a
# base image pulled >7 days ago is re-pulled on the next build. Images backing
# an existing container (distrobox/toolbox) count as in use and stay.
if command -v podman >/dev/null; then
    while IFS=: read -r user _ uid _ _ home _; do
        [[ $uid -ge 1000 && $uid -lt 60000 && -d $home/.local/share/containers ]] || continue
        echo "== podman ($user) before"
        runuser -u "$user" -- podman system df
        runuser -u "$user" -- podman system prune --all --force --filter "until=${age}"
        echo "== podman ($user) after"
        runuser -u "$user" -- podman system df
    done < <(getent passwd)
fi

if command -v flatpak >/dev/null; then
    echo "== flatpak: unused runtimes"
    flatpak uninstall --system --unused --noninteractive -y || true
fi
