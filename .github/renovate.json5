{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  // Quickshell is built from an upstream release tag, pinned to its commit
  // (build_files/quickshell/quickshell.spec). Renovate proposes a PR when a new
  // release is tagged (every 1-4 months), updating tag and commit together, so
  // every bump is a reviewable, revertible, smoke-tested commit.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^build_files/quickshell/quickshell\\.spec$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n%global uptag\\s+(?<currentValue>\\S+)\\n%global commit\\s+(?<currentDigest>[a-f0-9]{40})"
      ],
    },
  ],

  // Renovate's scope is Quickshell (above) and cosign; everything else is
  // handled elsewhere or on purpose.
  "packageRules": [
    {
      // Containerfile base images: the silverblue-main tag IS the Fedora
      // release (a deliberate, VM-tested bump - see CLAUDE.md "Version bumps"),
      // the akmods tag follows the base kernel via the Justfile, and pinning
      // digests would stop the daily build picking up Fedora updates.
      "matchManagers": ["dockerfile"],
      "enabled": false,
    },
    {
      // GitHub Actions: Dependabot (.github/dependabot.yml) already bumps these.
      "matchManagers": ["github-actions"],
      "enabled": false,
    },
    {
      // ...except build.yml's `cosign-release` input, which Dependabot can't
      // see. Majors change the signing format: review those with care.
      "matchManagers": ["github-actions"],
      "matchDepNames": ["sigstore/cosign"],
      "enabled": true,
    },
  ]
}
